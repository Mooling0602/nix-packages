+/// Union of the enabled outputs, in logical coordinates.
+///
+/// The portal describes one zone per output while a libei client models the
+/// whole computer as a single device, so the region has to be the bounding box.
+/// niri is free to place an output at a negative offset and the protocol cannot
+/// express that, so the box is anchored at the origin instead.
+fn region_of(zones: &[niri::OutputZone]) -> Option<eis_server::Region> {
+    let mut width = 0u32;
+    let mut height = 0u32;
+    for zone in zones {
+        let right = u32::try_from(zone.zone.x.max(0))
+            .unwrap_or_default()
+            .saturating_add(zone.zone.width);
+        let bottom = u32::try_from(zone.zone.y.max(0))
+            .unwrap_or_default()
+            .saturating_add(zone.zone.height);
+        width = width.max(right);
+        height = height.max(bottom);
+    }
+
+    (width > 0 && height > 0).then_some(eis_server::Region { width, height })
+}
